# ==============================================================================
# ПРИМЕР ФАЙЛА ОКРУЖЕНИЯ ДЛЯ ПРОЕКТА «ДОМОФОНДАР» (domofondar)
# Скопируйте этот файл в .env на сервере и заполните вашими реальными значениями:
# cp .env.example .env
# ВНИМАНИЕ: Файл .env НЕ должен попадать в репозиторий Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Параметры базы данных PostgreSQL (контейнер domofondar_postgres)
# ------------------------------------------------------------------------------
POSTGRES_DB=domofondar
POSTGRES_USER=domofondar
# Задайте надежный пароль (минимум 20 символов):
POSTGRES_PASSWORD=generate_a_very_strong_password_here

# ------------------------------------------------------------------------------
# 2. Безопасность и JWT токены
# ------------------------------------------------------------------------------
# Секретный криптографический ключ для подписи сессий пользователей (минимум 32 символа):
JWT_SECRET=generate_a_random_jwt_secret_with_at_least_32_characters_here

# ------------------------------------------------------------------------------
# 3. PostgREST API (контейнер domofondar_postgrest)
# ------------------------------------------------------------------------------
PGRST_DB_SCHEMA=public
PGRST_DB_ANON_ROLE=anon

# ------------------------------------------------------------------------------
# 4. Frontend & Backend API URLs
# ------------------------------------------------------------------------------
# В продакшне запросы идут через Nginx по относительному пути /backend-api
VITE_API_URL=/backend-api
VITE_SUPABASE_URL=/api/rest/v1
VITE_SUPABASE_PUBLISHABLE_KEY=public-anon-key

# Дополнительные ключи DaData (если используются для автокомплита адресов)
VITE_DADATA_API_KEY=
VITE_DADATA_SECRET_KEY=

# ------------------------------------------------------------------------------
# 5. Домен и SSL (контейнер domofondar_frontend / Nginx)
# ------------------------------------------------------------------------------
# Основной домен: домофондар.рф (в кодировке punycode)
DOMAIN_NAME=xn--80aha5afebav9a.xn--p1ai
