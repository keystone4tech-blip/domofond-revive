@echo off
chcp 65001 > nul
title Установка автозапуска шлюза ДомофонДар 1С
echo ========================================================
echo   Установка автозапуска шлюза ДомофонДар 1С в Windows
echo ========================================================
echo.

set SCRIPT_DIR=%~dp0
set TASK_NAME=DomofonDar_1C_Bridge

echo [1/2] Проверка прав администратора...
net session >nul 2>&1
if %ERRORLEVEL% neq 0 (
    echo [ВНИМАНИЕ] Для создания задачи в планировщике требуются права Администратора.
    echo Запустите этот файл правой кнопкой мыши -> "Запуск от имени администратора".
    pause
    exit /b 1
)

echo [2/2] Создание задачи в Планировщике Windows (запуск при входе в систему)...
schtasks /create /tn "%TASK_NAME%" /tr "\"%SCRIPT_DIR%run_bridge.bat\"" /sc onlogon /rl highest /f

if %ERRORLEVEL% equ 0 (
    echo.
    echo [УСПЕХ] Задача автозапуска "%TASK_NAME%" успешно создана!
    echo Шлюз будет автоматически запускаться каждый раз при включении компьютера.
) else (
    echo.
    echo [ОШИБКА] Не удалось создать задачу в планировщике.
)

echo.
pause
