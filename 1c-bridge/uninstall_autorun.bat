@echo off
chcp 65001 > nul
title Удаление автозапуска шлюза ДомофонДар 1С
echo ========================================================
echo   Удаление автозапуска шлюза ДомофонДар 1С
echo ========================================================
echo.

set TASK_NAME=DomofonDar_1C_Bridge

echo [1/2] Проверка прав администратора...
net session >nul 2>&1
if %ERRORLEVEL% neq 0 (
    echo [ВНИМАНИЕ] Для удаления задачи требуются права Администратора.
    echo Запустите этот файл правой кнопкой мыши -> "Запуск от имени администратора".
    pause
    exit /b 1
)

echo [2/2] Удаление задачи "%TASK_NAME%" из Планировщика Windows...
schtasks /delete /tn "%TASK_NAME%" /f

if %ERRORLEVEL% equ 0 (
    echo.
    echo [УСПЕХ] Задача автозапуска успешно удалена.
) else (
    echo.
    echo [ИНФО] Задача не найдена или уже удалена.
)

echo.
pause
